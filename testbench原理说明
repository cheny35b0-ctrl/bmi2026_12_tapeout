  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.85rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.98rem;
    max-width: 820px;
  }

  .theme-btn {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
