    --accent: #0d9488;
    --accent-light: #f0fdfa;
    --warn: #d97706;
    --warn-light: #fffbeb;
    --code-bg: #1e293b;
    --code-text: #f8fafc;
    --kw: #93c5fd;
    --num: #fcd34d;
    --cmt: #94a3b8;
    --sig: #6ee7b7;
    --shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
